# Smart Garment Mobile – Environment Variables
# Copy to .env.local and fill in values

# Backend API URL
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api/v1

# Socket.IO server URL
EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:5000

# Image base URL
EXPO_PUBLIC_IMAGE_URL=http://10.0.2.2:5000/static/images

# For physical device testing, replace 10.0.2.2 with your LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.1.XXX:5000/api/v1
# EXPO_PUBLIC_SOCKET_URL=http://192.168.1.XXX:5000
# EXPO_PUBLIC_IMAGE_URL=http://192.168.1.XXX:5000/static/images

# For production:
# EXPO_PUBLIC_API_URL=https://api.smartgarment.com/api/v1
# EXPO_PUBLIC_SOCKET_URL=https://api.smartgarment.com
# EXPO_PUBLIC_IMAGE_URL=https://api.smartgarment.com/static/images
