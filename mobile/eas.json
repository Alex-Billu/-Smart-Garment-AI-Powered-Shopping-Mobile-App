{
  "cli": {
    "version": ">= 7.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:5000/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "http://10.0.2.2:5000",
        "EXPO_PUBLIC_IMAGE_URL": "http://10.0.2.2:5000/static/images"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://YOUR_LAN_IP:5000/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "http://YOUR_LAN_IP:5000",
        "EXPO_PUBLIC_IMAGE_URL": "http://YOUR_LAN_IP:5000/static/images"
      }
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "remote"
      },
      "ios": {
        "credentialsSource": "remote"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.smartgarment.com/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.smartgarment.com",
        "EXPO_PUBLIC_IMAGE_URL": "https://api.smartgarment.com/static/images"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./credentials/google-service-account.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "your.apple.id@email.com",
        "ascAppId": "YOUR_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "YOUR_APPLE_TEAM_ID"
      }
    }
  }
}
